@using KeinishkataKushta.Web.Areas.Admin.Models
@model List<GalleryImageListItemViewModel>
@{
    var roomId = ViewData["CaptionRoomId"] as int?;
    var draft = ViewData["CaptionDraft"] as GalleryCaptionBatchViewModel;
}
<section data-caption-editor aria-label="Photo captions">
    <form id="caption-batch" asp-area="Admin" asp-controller="Gallery" asp-action="SaveCaptions" method="post" class="border rounded bg-light p-3 mb-4">
        @Html.AntiForgeryToken()
        <input type="hidden" name="RoomId" value="@roomId" />
        <h2 class="h4">Edit photo captions</h2>
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <p>Edit any Bulgarian or English captions below, then save them together. Empty English captions use the Bulgarian text on the public site. Maximum 500 characters per caption.</p>
        <button type="submit" class="btn btn-primary">Save all changes</button>
        <p class="small mt-2 mb-0" data-caption-status role="status" aria-live="polite">Changes are saved only when you choose Save all changes.</p>
        <fieldset data-caption-tools hidden class="mt-3">
            <legend class="h6">Apply a caption to selected photos</legend>
            <div class="row g-2">
                <div class="col-sm-4">
                    <label for="apply-language" class="form-label">Language</label>
                    <select id="apply-language" class="form-select" data-caption-language>
                        <option value="Caption">Bulgarian</option>
                        <option value="CaptionEn">English</option>
                    </select>
                </div>
                <div class="col-sm-8">
                    <label for="apply-caption" class="form-label">Caption to apply</label>
                    <input id="apply-caption" class="form-control" maxlength="500" data-caption-value />
                </div>
            </div>
            <div class="form-check my-2">
                <input id="replace-captions" type="checkbox" class="form-check-input" data-caption-replace />
                <label for="replace-captions" class="form-check-label">Replace existing nonempty captions in this language</label>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-secondary" data-caption-select-all>Select all photos</button>
                <button type="button" class="btn btn-outline-secondary" data-caption-select-none>Clear selection</button>
                <button type="button" class="btn btn-outline-primary" data-caption-apply>Apply to selected photos</button>
            </div>
            <p class="small mt-2 mb-0">Existing text is kept unless replacement is explicitly enabled. Applying changes the editable fields; review them before saving.</p>
        </fieldset>
    </form>
    <div class="row g-4">
        @for (var index = 0; index < Model.Count; index++)
        {
            var image = Model[index];
            var row = draft?.Rows.FirstOrDefault(item => item.Id == image.Id) ?? new GalleryCaptionRowViewModel
            {
                Id = image.Id, Caption = image.Caption, CaptionEn = image.CaptionEn,
                OriginalCaption = image.Caption, OriginalCaptionEn = image.CaptionEn
            };
            var prefix = $"Rows[{index}]";
            var source = roomId.HasValue ? $"~/uploads/rooms/{roomId}/{image.FileName}" : $"~/uploads/property/{image.FileName}";
            <div class="col-sm-6 col-lg-4 col-xl-3" data-caption-row>
                <div class="card h-100">
                    <img class="card-img-top admin-property-image" src="@Url.Content(source)" alt="@(image.Caption ?? $"Photo {image.Id}")" loading="lazy" decoding="async" />
                    <div class="card-body">
                        <div class="form-check mb-2" data-caption-selection hidden>
                            <input id="select-@image.Id" type="checkbox" class="form-check-input" data-caption-select />
                            <label for="select-@image.Id" class="form-check-label">Select photo @image.Id</label>
                        </div>
                        <input form="caption-batch" type="hidden" name="@(prefix).Id" value="@image.Id" />
                        <input form="caption-batch" type="hidden" name="@(prefix).OriginalCaption" value="@row.OriginalCaption" />
                        <input form="caption-batch" type="hidden" name="@(prefix).OriginalCaptionEn" value="@row.OriginalCaptionEn" />
                        <div class="mb-2">
                            <label for="caption-bg-@image.Id" class="form-label small">Caption (Bulgarian)</label>
                            <input form="caption-batch" id="caption-bg-@image.Id" name="@(prefix).Caption" value="@row.Caption" class="form-control form-control-sm" maxlength="500" data-caption-field="Caption" />
                        </div>
                        <div class="mb-3">
                            <label for="caption-en-@image.Id" class="form-label small">Caption (English)</label>
                            <input form="caption-batch" id="caption-en-@image.Id" name="@(prefix).CaptionEn" value="@row.CaptionEn" class="form-control form-control-sm" maxlength="500" data-caption-field="CaptionEn" />
                        </div>
                        @await Html.PartialAsync("_ImagePosition", new GalleryImagePositionViewModel
                        {
                            Id = image.Id, RoomId = roomId, Position = index + 1, Total = Model.Count
                        })
                        @if (roomId.HasValue && image.IsCover)
                        {
                            <span class="badge bg-success">Cover</span>
                        }
                        @if (roomId.HasValue && !image.IsCover)
                        {
                            <form asp-action="MakeCover" method="post" class="mt-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@image.Id" />
                                <button class="btn btn-sm btn-outline-success" type="submit">Make cover</button>
                            </form>
                        }
                        <form asp-action="@(roomId.HasValue ? "Delete" : "DeleteProperty")" method="post" class="mt-2" onsubmit="return confirm('Delete this image?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@image.Id" />
                            <input type="hidden" name="roomId" value="@roomId" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
    <button form="caption-batch" type="submit" class="btn btn-primary mt-4">Save all changes</button>
</section>
