@model KeinishkataKushta.Web.Areas.Admin.Models.GalleryIndexViewModel

@{
	ViewData["Title"] = "Gallery";
}

<h1>Gallery for: @Model.RoomName</h1>

@if (TempData["Err"] != null)
{
	<div class="alert alert-danger">@TempData["Err"]</div>
}

@if (TempData["Ok"] != null)
{
	<div class="alert alert-success">@TempData["Ok"]</div>
}


<form asp-area="Admin" asp-controller="Gallery" asp-action="Upload" method="post" enctype="multipart/form-data">
	@Html.AntiForgeryToken()
	<input type="hidden" asp-for="Upload.RoomId" />

	<div class="form-check mb-3">
		<input class="form-check-input" asp-for="Upload.IsCover" type="checkbox" />
		<label class="form-check-label" asp-for="Upload.IsCover">Use first photo as cover</label>
	</div>

	<div class="mb-3">
		<label asp-for="Upload.Files" class="form-label">Photos</label>
		<input asp-for="Upload.Files" type="file" class="form-control" multiple required
			   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
		<div class="form-text">Up to 20 photos. JPG, PNG, or WEBP. Maximum size: 5 MB each.</div>
	</div>

	<div class="mb-3">
		<label asp-for="Upload.Caption" class="form-label">Caption (Bulgarian, optional)</label>
		<input asp-for="Upload.Caption" class="form-control" />
	</div>

	<div class="mb-3">
		<label asp-for="Upload.CaptionEn" class="form-label">Caption (English, optional)</label>
		<input asp-for="Upload.CaptionEn" class="form-control" maxlength="500" />
	</div>

	<button class="btn btn-primary" type="submit">Upload photos</button>
	<a class="btn btn-secondary" asp-area="Admin" asp-controller="Room" asp-action="Index">Back to Rooms</a>
</form>

<hr />

@if (Model.Images.Count == 0)
{
	<p>No images yet.</p>
}
else
{
	<div class="row">
		@for (var index = 0; index < Model.Images.Count; index++)
		{
			var img = Model.Images[index];
			<div class="col-md-3 mb-4">
				<div class="card">
					<img class="card-img-top"
						 src="~/uploads/rooms/@Model.RoomId/@img.FileName"
						 alt="@img.Caption" loading="lazy" decoding="async" style="aspect-ratio:4/3;object-fit:cover;" />

					<div class="card-body">
						@await Html.PartialAsync("_ImageCaptions", new KeinishkataKushta.Web.Areas.Admin.Models.GalleryImageCaptionViewModel
						{
							Id = img.Id, RoomId = Model.RoomId, Caption = img.Caption, CaptionEn = img.CaptionEn
						})
						@await Html.PartialAsync("_ImagePosition", new KeinishkataKushta.Web.Areas.Admin.Models.GalleryImagePositionViewModel
						{
							Id = img.Id, RoomId = Model.RoomId, Position = index + 1, Total = Model.Images.Count
						})

						@if (img.IsCover) // Badge for cover image
						{
							<span class="badge bg-success">Cover</span>
						}

						@if (!img.IsCover)
						{
							<form asp-area="Admin" asp-controller="Gallery" asp-action="MakeCover" method="post" class="mt-2">
								@Html.AntiForgeryToken()
								<input type="hidden" name="id" value="@img.Id" />
								<input type="hidden" name="roomId" value="@Model.RoomId" />
								<button class="btn btn-sm btn-outline-success" type="submit">Make cover</button>
							</form>
						}


						<form asp-area="Admin" asp-controller="Gallery" asp-action="Delete" method="post" class="mt-2">
							@Html.AntiForgeryToken()
							<input type="hidden" name="id" value="@img.Id" />
							<input type="hidden" name="roomId" value="@Model.RoomId" />
							<button class="btn btn-sm btn-danger" type="submit">Delete</button>
						</form>
					</div>
				</div>
			</div>
		}
	</div>
}

