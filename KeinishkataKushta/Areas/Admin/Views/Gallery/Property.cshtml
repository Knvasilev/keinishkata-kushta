@model KeinishkataKushta.Web.Areas.Admin.Models.PropertyGalleryIndexViewModel

@{
    ViewData["Title"] = "House & Grounds Gallery";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">House &amp; Grounds Gallery</h1>
        <p class="text-muted mb-0">Courtyard, tavern, barbecue, exterior, and other shared spaces.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-area="" asp-controller="Gallery" asp-action="Index" target="_blank">
        View public gallery
    </a>
</div>

@if (TempData["Err"] != null)
{
    <div class="alert alert-danger">@TempData["Err"]</div>
}

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}

<form asp-area="Admin"
      asp-controller="Gallery"
      asp-action="UploadProperty"
      method="post"
      enctype="multipart/form-data"
      class="border rounded p-4 mb-4 bg-light">
    @Html.AntiForgeryToken()

    <div class="row g-3 align-items-end">
        <div class="col-lg-4">
            <label asp-for="Upload.Files" class="form-label">Photos</label>
            <input asp-for="Upload.Files"
                   type="file"
                   multiple
                   required
                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                   class="form-control" />
            <div class="form-text">Up to 20 photos. JPG, PNG, or WEBP. Maximum size: 5 MB each.</div>
        </div>
        <div class="col-lg-3">
            <label asp-for="Upload.Caption" class="form-label">Caption (Bulgarian, optional)</label>
            <input asp-for="Upload.Caption"
                   class="form-control"
                   placeholder="Двор / Courtyard" />
        </div>
        <div class="col-lg-3">
            <label asp-for="Upload.CaptionEn" class="form-label">Caption (English, optional)</label>
            <input asp-for="Upload.CaptionEn" class="form-control" maxlength="500" placeholder="Tavern &amp; Kitchen" />
        </div>
        <div class="col-lg-2 d-grid">
            <button class="btn btn-primary" type="submit">Upload photos</button>
        </div>
    </div>
</form>

@if (Model.Images.Count == 0)
{
    <div class="alert alert-info">No house or grounds photos have been uploaded yet.</div>
}
else
{
    <div class="row g-4">
        @for (var index = 0; index < Model.Images.Count; index++)
        {
            var image = Model.Images[index];
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <div class="card h-100">
                    <img class="card-img-top admin-property-image"
                         src="~/uploads/property/@image.FileName"
                         alt="@(image.Caption ?? "Property photo")" loading="lazy" decoding="async" />
                    <div class="card-body d-flex flex-column">
                        @await Html.PartialAsync("_ImageCaptions", new KeinishkataKushta.Web.Areas.Admin.Models.GalleryImageCaptionViewModel
                        {
                            Id = image.Id, Caption = image.Caption, CaptionEn = image.CaptionEn
                        })
                        @await Html.PartialAsync("_ImagePosition", new KeinishkataKushta.Web.Areas.Admin.Models.GalleryImagePositionViewModel
                        {
                            Id = image.Id, Position = index + 1, Total = Model.Images.Count
                        })
                        <form asp-area="Admin"
                              asp-controller="Gallery"
                              asp-action="DeleteProperty"
                              method="post" class="mt-2"
                              onsubmit="return confirm('Delete this image?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@image.Id" />
                            <button class="btn btn-sm btn-outline-danger w-100" type="submit">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
