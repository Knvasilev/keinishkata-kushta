@model KeinishkataKushta.Web.Areas.Admin.Models.RoomFormViewModel

<h1>Edit Room</h1>

<form asp-area="Admin" asp-controller="Room" asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div>
        <label asp-for="Name"></label><br />
        <input asp-for="Name" />
    </div>

    <div>
        <label asp-for="Slug"></label><br />
        <input asp-for="Slug" />
    </div>

    <div>
        <label asp-for="Description"></label><br />
        <textarea asp-for="Description" rows="5"></textarea>
    </div>

    <div>
        <label asp-for="Capacity"></label><br />
        <input asp-for="Capacity" type="number" />
    </div>

    <div>
        <label asp-for="PricePerNight"></label><br />
        <input asp-for="PricePerNight" type="number" step="0.01" />
    </div>

    <div>
        <label asp-for="IsPublished"></label>
        <input asp-for="IsPublished" type="checkbox" />
    </div>

    <button type="submit">Save</button>
    <a asp-area="Admin" asp-controller="Room" asp-action="Index">Cancel</a>
</form>
