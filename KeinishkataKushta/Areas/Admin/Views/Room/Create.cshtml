@model KeinishkataKushta.Web.Areas.Admin.Models.RoomFormViewModel

<h1>Create Room</h1>

<form asp-area="Admin" asp-controller="Room" asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <p>Enter Bulgarian content in the Bulgarian fields and English content in the English fields. Empty English fields display the original content independently; this is not an automatic translation.</p>
    <div>
        <label asp-for="Name"></label><br />
        <input asp-for="Name" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="NameEn"></label><br />
        <input asp-for="NameEn" maxlength="200" />
        <span asp-validation-for="NameEn" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Slug"></label><br />
        <input asp-for="Slug" />
        <span asp-validation-for="Slug" class="text-danger"></span>
        <small>Leave empty to auto-generate from name</small>
    </div>

    <div>
        <label asp-for="Description"></label><br />
        <textarea asp-for="Description" rows="5"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="DescriptionEn"></label><br />
        <textarea asp-for="DescriptionEn" rows="5" maxlength="4000"></textarea>
        <span asp-validation-for="DescriptionEn" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Capacity"></label><br />
        <input asp-for="Capacity" type="number" />
        <span asp-validation-for="Capacity" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="PricePerNight"></label><br />
        <input asp-for="PricePerNight" type="number" step="0.01" />
        <span asp-validation-for="PricePerNight" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="IsPublished"></label>
        <input asp-for="IsPublished" type="checkbox" />
    </div>

    <button type="submit">Save</button>
    <a asp-area="Admin" asp-controller="Room" asp-action="Index">Cancel</a>
</form>
