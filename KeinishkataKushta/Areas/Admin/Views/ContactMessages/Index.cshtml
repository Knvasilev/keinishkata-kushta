@model List<KeinishkataKushta.Data.Entities.ContactMessage>

@{
    ViewData["Title"] = "Contact Messages";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="mb-0">Contact Messages</h1>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No contact messages yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Sent</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var message in Model)
                {
                    <tr>
                        <td>@message.CreatedUtc.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@message.Name</td>
                        <td>
                            <a href="mailto:@message.Email">@message.Email</a>
                        </td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(message.Phone))
                            {
                                <span class="text-muted">-</span>
                            }
                            else
                            {
                                @message.Phone
                            }
                        </td>
                        <td>
                            @if (message.IsProcessed)
                            {
                                <span class="badge bg-success">Processed</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">New</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary"
                               asp-area="Admin"
                               asp-controller="ContactMessages"
                               asp-action="Details"
                               asp-route-id="@message.Id">Details</a>

                            <form asp-area="Admin"
                                  asp-controller="ContactMessages"
                                  asp-action="Delete"
                                  asp-route-id="@message.Id"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Delete this message?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
