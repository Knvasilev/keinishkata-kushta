@model KeinishkataKushta.Data.Entities.ContactMessage

@{
    ViewData["Title"] = "Contact Message Details";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="mb-0">Contact Message Details</h1>

    <a class="btn btn-outline-secondary"
       asp-area="Admin"
       asp-controller="ContactMessages"
       asp-action="Index">Back to messages</a>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Sent</dt>
            <dd class="col-sm-9">@Model.CreatedUtc.ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">
                <a href="mailto:@Model.Email">@Model.Email</a>
            </dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">
                @if (string.IsNullOrWhiteSpace(Model.Phone))
                {
                    <span class="text-muted">-</span>
                }
                else
                {
                    @Model.Phone
                }
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsProcessed)
                {
                    <span class="badge bg-success">Processed</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">New</span>
                }
            </dd>

            <dt class="col-sm-3">Message</dt>
            <dd class="col-sm-9" style="white-space: pre-line;">@Model.Message</dd>
        </dl>
    </div>
</div>

<form asp-area="Admin"
      asp-controller="ContactMessages"
      asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post"
      class="mt-3"
      onsubmit="return confirm('Delete this message?');">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete message</button>
</form>
