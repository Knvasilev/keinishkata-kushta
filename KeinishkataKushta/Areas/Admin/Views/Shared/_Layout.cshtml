<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-area="Admin" asp-controller="Home" asp-action="Index">Admin</a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="navbar-nav me-auto">
                    <a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index">Dashboard</a>
                    <a class="nav-link" asp-area="Admin" asp-controller="Room" asp-action="Index">Rooms</a>
                    <a class="nav-link" asp-area="Admin" asp-controller="Gallery" asp-action="Property">House Gallery</a>
                    <a class="nav-link" asp-area="Admin" asp-controller="Availability" asp-action="Index">@KeinishkataKushta.Infrastructure.SiteText.T(Context, "Availability")</a>
                    <a class="nav-link" asp-area="Admin" asp-controller="ContactMessages" asp-action="Index">Contact Messages</a>
                </div>
                <div class="d-flex align-items-center gap-3 text-white">
                    <span class="small">@User.Identity.Name</span>
                    <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-light">Изход</button>
                    </form>
                </div>
            }
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
