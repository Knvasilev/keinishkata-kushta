@model RoomDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
    var cover = Model.Images.FirstOrDefault();
}

<section class="container-xxl room-details-heading">
    <div>
        <p class="eyebrow text-gold">@SiteText.T(Context, "Rooms")</p>
        <h1>@Model.Name</h1>
        <div class="room-details-actions">
            <a class="btn btn-primary" asp-controller="Availability" asp-action="Index">@SiteText.T(Context, "RoomCheckDates")</a>
            <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Contact">@SiteText.T(Context, "AvailabilityEnquire")</a>
        </div>
    </div>
    <div class="room-details-meta">
        <span>@SiteText.T(Context, "UpTo") @Model.Capacity @SiteText.T(Context, "Guests")</span>
        <strong>@CurrencyText.Euro(Context, Model.PricePerNight) / @SiteText.T(Context, "Night")</strong>
        @if (CurrencyText.ShowLevEquivalent())
        {
            <small class="legacy-price">≈ @CurrencyText.LevEquivalent(Context, Model.PricePerNight)</small>
        }
    </div>
</section>

<section class="container-xxl room-photography" data-gallery-collection aria-label="@SiteText.T(Context, "RoomPhotos")">
    @if (cover != null)
    {
        <button class="image-zoom-frame room-cover-frame gallery-trigger"
                type="button"
                data-gallery-trigger
                data-gallery-src="@Url.Content($"~/uploads/rooms/{Model.Id}/{cover.FileName}")"
                data-gallery-caption="@(cover.Caption ?? Model.Name)"
                aria-label="@SiteText.T(Context, "OpenImage"): @(cover.Caption ?? Model.Name)">
            <img class="room-detail-cover" src="~/uploads/rooms/@Model.Id/@cover.FileName" alt="@(cover.Caption ?? Model.Name)" fetchpriority="high" decoding="async" />
        </button>
        <div class="room-photos-toolbar">
            <h2>@SiteText.T(Context, "RoomPhotos")</h2>
            <button class="btn btn-outline-primary" type="button" data-gallery-open aria-haspopup="dialog">
                @SiteText.T(Context, "RoomViewAllPhotos") (@Model.Images.Count)
            </button>
        </div>
    }
    else
    {
        <div class="section-band"><p class="mb-0">@SiteText.T(Context, "RoomPhotosEmpty")</p></div>
    }

    @if (Model.Images.Count > 1)
    {
        <div class="room-gallery">
            @for (var index = 1; index < Model.Images.Count; index++)
            {
                var image = Model.Images[index];
                // Keep every item in saved order for the existing lightbox, without loading hidden images.
                <button class="image-zoom-frame gallery-trigger"
                        type="button"
                        hidden="@(index > 4)"
                        data-gallery-trigger
                        data-gallery-src="@Url.Content($"~/uploads/rooms/{Model.Id}/{image.FileName}")"
                        data-gallery-caption="@(image.Caption ?? Model.Name)"
                        aria-label="@SiteText.T(Context, "OpenImage"): @(image.Caption ?? Model.Name)">
                    @if (index <= 4)
                    {
                        <img src="~/uploads/rooms/@Model.Id/@image.FileName" alt="@(image.Caption ?? Model.Name)" loading="lazy" decoding="async" />
                    }
                </button>
            }
        </div>
    }
</section>

<section class="container-xxl room-description" aria-labelledby="room-description-title">
    <h2 id="room-description-title">@SiteText.T(Context, "RoomAbout")</h2>
    <p class="room-description-copy">@Model.Description</p>
    <p class="room-heating-note">@SiteText.T(Context, "RoomUnderfloorHeating")</p>
</section>

<partial name="_GalleryLightbox" model="@(new GalleryLightboxViewModel(Model.Name, Model.Images.Count))" />

<section class="section-block">
    <div class="container-xxl">
        <div class="section-band">
            <div class="row g-4 align-items-center">
                <div class="col-lg-8">
                    <h2 class="section-title">@SiteText.T(Context, "RoomInterested")</h2>
                    <p class="mb-0">@SiteText.T(Context, "RoomInterestedCopy")</p>
                </div>
                <div class="col-lg-4 room-details-actions">
                    <a class="btn btn-outline-primary" asp-controller="Availability" asp-action="Index">@SiteText.T(Context, "Availability")</a>
                    <a class="btn btn-primary" asp-controller="Home" asp-action="Contact">@SiteText.T(Context, "AskUs")</a>
                </div>
            </div>
        </div>
    </div>
</section>
